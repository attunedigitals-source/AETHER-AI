# ==============================================================================
# AETHER AI CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# OPENROUTER CONFIGURATION (MANDATORY FOR AI INFERENCE)
# ------------------------------------------------------------------------------
# Get your API key from: https://openrouter.ai/settings/keys
# This key is strictly server-side and will NEVER be leaked to frontend or logs.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Aether AI
OPENROUTER_SITE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (FOR CLOUD AUTH & PERSISTENT POSTGRESQL DATABASE)
# ------------------------------------------------------------------------------
# Create a free project at https://supabase.com
# Execute the SQL in supabase/schema.sql in the Supabase SQL Editor.
# If these are left blank, Aether seamlessly falls back to local persistent storage.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

